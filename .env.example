# ─────────────────────────────────────────────────────────────────────────────
# ShipKit — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Required.
DATABASE_URL=postgres://shipkit:changeme@localhost:5432/shipkit

# ── API Server ────────────────────────────────────────────────────────────────
# Port the Express API server listens on. Defaults to 5000 if not set.
PORT=5000

# 32+ character random string used to sign sessions.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-64-char-hex-string

# AES encryption key for credentials stored in the database.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-a-random-64-char-hex-string

# ── Build Workspace ───────────────────────────────────────────────────────────
# Directory where uploaded zip sources and EAS build artifacts are stored.
# Must be a writable path. Defaults to ./build-workspace relative to the API server.
SHIPKIT_BUILD_DIR=./build-workspace

# ── Frontend (Docker/production only) ────────────────────────────────────────
# Absolute path to the pre-built dashboard static files. When set, the API
# server serves the frontend at /. Leave blank in development (Vite handles it).
# STATIC_DIR=/app/dashboard-dist

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal Access Token with repo scope. Used for code sync when the
# Replit GitHub integration is not available.
# Can also be set per-pipeline: SHIPKIT_PIPELINE_<id>_GITHUB_TOKEN
SHIPKIT_GITHUB_TOKEN=

# Shared HMAC secret for the GitHub webhook (auto-deploy on push feature).
# Set in GitHub: Settings → Webhooks → Secret.
SHIPKIT_GITHUB_WEBHOOK_SECRET=

# ── EAS / Expo ────────────────────────────────────────────────────────────────
# EAS personal access token. Can also be set per-pipeline.
SHIPKIT_EAS_TOKEN=

# ── App Store Connect ─────────────────────────────────────────────────────────
# API key credentials for TestFlight submission. Can also be set per-pipeline.
SHIPKIT_APP_STORE_KEY_ID=
SHIPKIT_APP_STORE_ISSUER_ID=
# Multi-line .p8 private key — paste the full contents including header/footer.
SHIPKIT_APP_STORE_PRIVATE_KEY=
